{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",   // 👈 REQUIRED for paths to work!
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.sql",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
